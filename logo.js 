
/* =====================================================
   ZUNE GLOBAL LOGO SYSTEM
   File: logo.js
   Logo source: logo.svg
   ===================================================== */

(function () {
  "use strict";

  // Zuia kuweka mfumo huu mara mbili kwenye ukurasa mmoja.
  if (window.ZUNE_LOGO_INITIALIZED) return;
  window.ZUNE_LOGO_INITIALIZED = true;

  // Mipangilio ya logo.
  const CONFIG = {
    logoPath: "logo.svg",
    homePage: "index.html",
    defaultSize: 64,
    smallSize: 42,
    altText: "ZUNE Logo"
  };

  // CSS ya pamoja ya logo.
  const css = `
    .zune-brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      text-decoration: none;
      line-height: 0;
      vertical-align: middle;
    }

    .zune-brand img {
      display: block;
      width: var(--zune-logo-size, 64px);
      height: var(--zune-logo-size, 64px);
      max-width: 100%;
      object-fit: contain;
      border: 0;
      outline: none;
    }

    .zune-brand.small {
      --zune-logo-size: 42px;
    }

    .zune-brand.medium {
      --zune-logo-size: 64px;
    }

    .zune-brand.large {
      --zune-logo-size: 100px;
    }

    .zune-brand.round img {
      border-radius: 50%;
    }

    .zune-brand:focus-visible {
      outline: 2px solid #F28C1D;
      outline-offset: 4px;
      border-radius: 8px;
    }

    @media (max-width: 480px) {
      .zune-brand.mobile-small {
        --zune-logo-size: 38px;
      }
    }
  `;

  // Ongeza CSS kwenye ukurasa.
  function addStyles() {
    if (document.getElementById("zune-logo-styles")) return;

    const style = document.createElement("style");
    style.id = "zune-logo-styles";
    style.textContent = css;
    document.head.appendChild(style);
  }

  // Tengeneza logo inayotumia faili moja la SVG.
  function createLogo(options = {}) {
    const {
      size = "medium",
      className = "",
      alt = CONFIG.altText,
      homePage = CONFIG.homePage
    } = options;

    const link = document.createElement("a");
    link.className = `zune-brand ${size} ${className}`.trim();
    link.href = homePage;
    link.setAttribute("aria-label", "ZUNE - Mwanzo");

    const image = document.createElement("img");
    image.src = CONFIG.logoPath;
    image.alt = alt;
    image.loading = "eager";
    image.decoding = "async";

    // Onyesha ujumbe wa kawaida kama faili halipatikani.
    image.addEventListener("error", function () {
      link.setAttribute("data-logo-error", "true");
      console.error(
        "ZUNE: Imeshindwa kupakia logo. Hakikisha logo.svg ipo pamoja na faili za HTML."
      );
    }, { once: true });

    link.appendChild(image);
    return link;
  }

  // Weka logo ndani ya sehemu zote zilizotayarishwa.
  function renderLogos() {
    document.querySelectorAll("[data-zune-logo]").forEach(function (target) {
      // Usirudie logo ikiwa tayari imewekwa.
      if (target.dataset.zuneLogoRendered === "true") return;

      const size = target.dataset.logoSize || "medium";
      const extraClass = target.dataset.logoClass || "";
      const alt = target.dataset.logoAlt || CONFIG.altText;
      const homePage = target.dataset.logoHome || CONFIG.homePage;

      target.replaceChildren(
        createLogo({
          size: size,
          className: extraClass,
          alt: alt,
          homePage: homePage
        })
      );

      target.dataset.zuneLogoRendered = "true";
    });
  }

  // Ruhusu JavaScript nyingine kutumia mfumo huu.
  window.ZUNELogo = {
    render: renderLogos,
    create: createLogo,
    config: CONFIG
  };

  // Anzisha mfumo.
  function init() {
    addStyles();
    renderLogos();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
})();
