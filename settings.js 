import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const SUPABASE_URL =
  "https://rpkogiieegqgxqbzwxwo.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  "sb_publishable_2TEqZv-NBM9n5knU46qgA_wqO3V1uf";

const supabase = createClient(
  SUPABASE_URL,
  SUPABASE_PUBLISHABLE_KEY,
  {
    auth: {
      persistSession: true,
      autoRefreshToken: true,
      detectSessionInUrl: true,
      flowType: "pkce"
    }
  }
);

const SETTINGS_CONFIG = {
  home: "index.html",
  login: "login.html",
  account: "account.html",
  settings: "settings.html",
  languageKey: "zune_language",
  themeKey: "zune_theme"
};

const $ = (selector, root = document) =>
  root.querySelector(selector);

const $$ = (selector, root = document) =>
  Array.from(root.querySelectorAll(selector));

const byId = (id) =>
  document.getElementById(id);

function setText(id, value) {
  const element = byId(id);
  if (!element) return;

  element.textContent =
    value === null ||
    value === undefined ||
    value === ""
      ? "Haijawekwa"
      : String(value);
}

function showMessage(message, type = "info") {
  const target =
    byId("settingsMessage") ||
    byId("settingsGlobalMessage") ||
    byId("settingsStatusMessage");

  if (!target) return;

  target.textContent = message;
  target.dataset.type = type;
  target.hidden = false;
  target.setAttribute("role", "status");
}

function getSetting(key, fallback = "") {
  try {
    return localStorage.getItem(key) ?? fallback;
  } catch {
    return fallback;
  }
}

function saveSetting(key, value) {
  try {
    localStorage.setItem(key, value);
    return true;
  } catch (error) {
    console.error("ZUNE storage error:", error);
    return false;
  }
}

function navigateTo(page) {
  const allowedPages = [
    "index.html",
    "login.html",
    "account.html",
    "settings.html",
    "settings-account.html",
    "settings-security.html",
    "settings-lock.html",
    "settings-verification.html",
    "settings-language.html",
    "settings-theme.html",
    "settings-notifications.html",
    "settings-location.html",
    "settings-seller.html",
    "seller.html",
    "cart.html",
    "category.html",
    "terms.html",
    "privacy.html"
  ];

  if (!allowedPages.includes(page)) {
    console.error("ZUNE: Ukurasa haujaruhusiwa.");
    return;
  }

  window.location.assign(page);
}

let currentSession = null;
let currentUser = null;
let currentProfile = null;
let settingsInitialized = false;
async function loadCurrentUser() {
  try {
    const {
      data: { session },
      error: sessionError
    } = await supabase.auth.getSession();

    if (sessionError) {
      throw sessionError;
    }

    if (!session?.user) {
      currentSession = null;
      currentUser = null;
      currentProfile = null;

      window.location.replace("login.html");
      return null;
    }

    currentSession = session;
    currentUser = session.user;

    const {
      data: profile,
      error: profileError
    } = await supabase
      .from("profiles")
      .select(
        "id, full_name, phone_number, role, is_verified, created_at"
      )
      .eq("id", currentUser.id)
      .maybeSingle();

    if (profileError) {
      console.error(
        "ZUNE profile error:",
        profileError
      );

      showMessage(
        "Imeshindwa kusoma taarifa za akaunti.",
        "error"
      );

      return null;
    }

    currentProfile = profile;

    renderUserProfile();

    return {
      session: currentSession,
      user: currentUser,
      profile: currentProfile
    };
  } catch (error) {
    console.error(
      "ZUNE user loading error:",
      error
    );

    showMessage(
      "Imeshindwa kupakia akaunti. Jaribu tena.",
      "error"
    );

    return null;
  }
}

/* ---------- USER PROFILE ---------- */

function renderUserProfile() {
  if (!currentUser) return;

  const name =
    currentProfile?.full_name ||
    currentUser.user_metadata?.full_name ||
    currentUser.user_metadata?.name ||
    "Mtumiaji wa ZUNE";

  const email =
    currentUser.email || "Haijawekwa";

  const phone =
    currentProfile?.phone_number ||
    currentUser.phone ||
    "Haijawekwa";

  const role =
    currentProfile?.role || "buyer";

  setText("settingsUserName", name);
  setText("settingsUserEmail", email);
  setText("settingsUserPhone", phone);

  const roleLabels = {
    buyer: "Mteja",
    vendor: "Muuzaji",
    admin: "Admin"
  };

  setText(
    "settingsRoleBadge",
    roleLabels[role] || role
  );

  renderVerificationStatus();
  renderProfileAvatar(name);
}

/* ---------- VERIFICATION ---------- */

function renderVerificationStatus() {
  const badge = byId("settingsVerificationBadge");

  if (!badge) return;

  const verified =
    currentProfile?.is_verified === true;

  badge.textContent = verified
    ? "✓ Verified"
    : "Haijathibitishwa";

  badge.dataset.verified = String(verified);
  badge.classList.toggle("verified", verified);
  badge.classList.toggle("not-verified", !verified);
}

/* ---------- AVATAR ---------- */

function renderProfileAvatar(name) {
  const avatar = byId("settingsAvatar");

  if (!avatar) return;

  const initials = String(name)
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0].toUpperCase())
    .join("");

  avatar.textContent = initials || "Z";
}

/* ---------- REFRESH PROFILE ---------- */

async function refreshUserProfile() {
  if (!currentUser) {
    return await loadCurrentUser();
  }

  const {
    data: profile,
    error
  } = await supabase
    .from("profiles")
    .select(
      "id, full_name, phone_number, role, is_verified, created_at"
    )
    .eq("id", currentUser.id)
    .maybeSingle();

  if (error) {
    console.error(
      "ZUNE profile refresh error:",
      error
    );

    showMessage(
      "Imeshindwa kusasisha taarifa za akaunti.",
      "error"
    );

    return null;
  }

  currentProfile = profile;
  renderUserProfile();

  return currentProfile;
}
/* ---------- LOGOUT ---------- */

async function logoutCurrentUser() {
  const logoutButton = byId("settingsLogoutButton");

  if (logoutButton) {
    logoutButton.disabled = true;
    logoutButton.setAttribute("aria-busy", "true");
  }

  try {
    const { error } = await supabase.auth.signOut();

    if (error) {
      throw error;
    }

    currentSession = null;
    currentUser = null;
    currentProfile = null;

    try {
      localStorage.removeItem("zune_logged_in");
    } catch (storageError) {
      console.warn(
        "ZUNE local storage cleanup error:",
        storageError
      );
    }

    window.location.replace("login.html");
  } catch (error) {
    console.error("ZUNE logout error:", error);

    showMessage(
      "Imeshindwa kutoka. Tafadhali jaribu tena.",
      "error"
    );

    if (logoutButton) {
      logoutButton.disabled = false;
      logoutButton.removeAttribute("aria-busy");
    }
  }
}

function initializeLogout() {
  const logoutButton = byId("settingsLogoutButton");

  if (!logoutButton) return;

  logoutButton.addEventListener("click", async (event) => {
    event.preventDefault();

    const confirmed = window.confirm(
      "Je, una uhakika unataka kutoka kwenye akaunti yako ya ZUNE?"
    );

    if (!confirmed) return;

    await logoutCurrentUser();
  });
}

/* ---------- TERMS AND PRIVACY ---------- */

function initializeLegalLinks() {
  $$('a[href="terms.html"], a[href="privacy.html"]')
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const destination = link.getAttribute("href");

        if (
          destination !== "terms.html" &&
          destination !== "privacy.html"
        ) {
          event.preventDefault();
        }
      });
    });
}

/* ---------- AUTH STATE ---------- */

function initializeAuthListener() {
  supabase.auth.onAuthStateChange(
    (event, session) => {
      if (event === "SIGNED_OUT") {
        currentSession = null;
        currentUser = null;
        currentProfile = null;

        if (!window.location.pathname.endsWith("login.html")) {
          window.location.replace("login.html");
        }

        return;
      }

      if (session?.user) {
        currentSession = session;
        currentUser = session.user;
      }
    }
  );
}

/* ---------- RETRY PROFILE ---------- */

function initializeProfileRefresh() {
  const refreshButton =
    byId("settingsRefreshProfile");

  if (!refreshButton) return;

  refreshButton.addEventListener("click", async () => {
    refreshButton.disabled = true;

    try {
      await refreshUserProfile();

      showMessage(
        "Taarifa za akaunti zimesasishwa.",
        "success"
      );
    } catch (error) {
      console.error(
        "ZUNE profile refresh error:",
        error
      );

      showMessage(
        "Imeshindwa kusasisha taarifa.",
        "error"
      );
    } finally {
      refreshButton.disabled = false;
    }
  });
}

/* ---------- PAGE NAVIGATION ---------- */

const SETTINGS_PAGE_MAP = {
  account: "account.html",
  security: "settings-security.html",
  "zune-lock": "settings-lock.html",
  verification: "settings-verification.html",
  language: "settings-language.html",
  theme: "settings-theme.html",
  notifications: "settings-notifications.html",
  location: "settings-location.html",
  seller: "settings-seller.html"
};

function initializeSettingsNavigation() {
  $$("[data-page]").forEach((element) => {
    element.addEventListener("click", (event) => {
      const pageName = element.dataset.page;
      const destination = SETTINGS_PAGE_MAP[pageName];

      if (!destination) {
        event.preventDefault();
        showMessage(
          "Ukurasa huu haujatambuliwa.",
          "error"
        );
        return;
      }

      if (element.tagName === "A") {
        element.href = destination;
        return;
      }

      event.preventDefault();
      navigateTo(destination);
    });
  });
}

/* ---------- THEME ---------- */

function getCurrentTheme() {
  const savedTheme = getSetting(
    SETTINGS_CONFIG.themeKey,
    "light"
  );

  return savedTheme === "dark" ? "dark" : "light";
}

function applyTheme(theme) {
  const selectedTheme =
    theme === "dark" ? "dark" : "light";

  document.body.classList.toggle(
    "dark-theme",
    selectedTheme === "dark"
  );

  document.documentElement.dataset.theme =
    selectedTheme;

  saveSetting(
    SETTINGS_CONFIG.themeKey,
    selectedTheme
  );

  setText(
    "currentThemeBadge",
    selectedTheme === "dark"
      ? "Giza"
      : "Mwanga"
  );

  const themeButton = byId("settingsThemeQuick");

  if (themeButton) {
    themeButton.setAttribute(
      "aria-label",
      selectedTheme === "dark"
        ? "Badilisha kwenda theme ya mwanga"
        : "Badilisha kwenda theme ya giza"
    );

    themeButton.setAttribute(
      "aria-pressed",
      String(selectedTheme === "dark")
    );
  }

  return selectedTheme;
}

function initializeTheme() {
  applyTheme(getCurrentTheme());

  const themeButton = byId("settingsThemeQuick");

  if (!themeButton) return;

  themeButton.addEventListener("click", () => {
    const nextTheme =
      getCurrentTheme() === "dark"
        ? "light"
        : "dark";

    applyTheme(nextTheme);
  });
}

/* ---------- LANGUAGE ---------- */

function getCurrentLanguage() {
  const savedLanguage = getSetting(
    SETTINGS_CONFIG.languageKey,
    "sw"
  );

  return ["sw", "en"].includes(savedLanguage)
    ? savedLanguage
    : "sw";
}

function applyLanguage(language) {
  const selectedLanguage =
    ["sw", "en"].includes(language)
      ? language
      : "sw";

  document.documentElement.lang =
    selectedLanguage;

  saveSetting(
    SETTINGS_CONFIG.languageKey,
    selectedLanguage
  );

  setText(
    "currentLanguageBadge",
    selectedLanguage === "sw"
      ? "Kiswahili"
      : "English"
  );

  return selectedLanguage;
}

function initializeLanguage() {
  applyLanguage(getCurrentLanguage());
}

/* ---------- CURRENT PAGE STATE ---------- */

function initializeSettingsPreferences() {
  initializeTheme();
  initializeLanguage();
}
/* ---------- INITIALIZE SETTINGS ---------- */

async function initializeSettings() {
  if (settingsInitialized) return;

  settingsInitialized = true;

  initializeSettingsPreferences();
  initializeSettingsNavigation();
  initializeLogout();
  initializeLegalLinks();
  initializeAuthListener();
  initializeProfileRefresh();

  await loadCurrentUser();
}

/* ---------- START APPLICATION ---------- */

if (document.readyState === "loading") {
  document.addEventListener(
    "DOMContentLoaded",
    initializeSettings,
    { once: true }
  );
} else {
  initializeSettings();
}

/* ---------- EXPORT FOR OTHER MODULES ---------- */

export {
  supabase,
  loadCurrentUser,
  refreshUserProfile,
  applyTheme,
  applyLanguage,
  navigateTo,
  logoutCurrentUser
};

